{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "signalflow://contracts/envelope/1.0",
  "title": "SignalFlow event envelope v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "source_system",
    "event_time",
    "produced_at",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "event_type": {
      "type": "string",
      "pattern": "^(telecom|mfg)\\.[a-z_]+$"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "source_system": {
      "type": "string",
      "enum": [
        "tel-ocs",
        "tel-billing",
        "tel-crm",
        "tel-mediation",
        "tel-payment-gw",
        "tel-provisioning",
        "mfg-erp",
        "mfg-mes",
        "mfg-wms"
      ]
    },
    "event_time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "produced_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "payload": {
      "type": "object"
    }
  }
}
