{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "signalflow://contracts/mfg.invoice/1.0",
  "title": "mfg.invoice v1.0",
  "description": "Invoice issued to a dealer for a dispatched shipment.",
  "x-business-key": "invoice_id",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "invoice_id",
    "shipment_id",
    "order_id",
    "dealer_id",
    "amount_bdt",
    "due_date"
  ],
  "properties": {
    "invoice_id": {
      "type": "string",
      "pattern": "^INV-[0-9A-F]{12}$"
    },
    "shipment_id": {
      "type": "string",
      "pattern": "^SHP-[0-9A-F]{12}$"
    },
    "order_id": {
      "type": "string",
      "pattern": "^ORD-[0-9A-F]{12}$"
    },
    "dealer_id": {
      "type": "string",
      "pattern": "^DLR-[0-9]{4}$"
    },
    "amount_bdt": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000000,
      "x-decimal-places": 2
    },
    "due_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
