{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "signalflow://contracts/mfg.supply_disruption/1.0",
  "title": "mfg.supply_disruption v1.0",
  "description": "Factory production stoppage notice.",
  "x-business-key": "disruption_id",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "disruption_id",
    "factory_id",
    "reason",
    "expected_duration_hours",
    "severity"
  ],
  "properties": {
    "disruption_id": {
      "type": "string",
      "pattern": "^DSR-[0-9A-F]{12}$"
    },
    "factory_id": {
      "type": "string",
      "pattern": "^FAC-[0-9]{2}$"
    },
    "reason": {
      "type": "string",
      "enum": [
        "POWER_OUTAGE",
        "COMPONENT_SHORTAGE",
        "PORT_DELAY",
        "MAINTENANCE"
      ]
    },
    "expected_duration_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 720
    },
    "severity": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    }
  }
}
