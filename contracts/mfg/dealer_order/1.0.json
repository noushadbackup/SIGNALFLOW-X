{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "signalflow://contracts/mfg.dealer_order/1.0",
  "title": "mfg.dealer_order v1.0",
  "description": "Dealer purchase order line (one SKU per order).",
  "x-business-key": "order_id",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "dealer_id",
    "sku",
    "quantity",
    "unit_price_bdt"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "pattern": "^ORD-[0-9A-F]{12}$"
    },
    "dealer_id": {
      "type": "string",
      "pattern": "^DLR-[0-9]{4}$"
    },
    "sku": {
      "type": "string",
      "pattern": "^[A-Z]{2,3}-[A-Z0-9]{2,8}$"
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "unit_price_bdt": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000000,
      "x-decimal-places": 2
    }
  }
}
