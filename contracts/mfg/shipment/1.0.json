{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "signalflow://contracts/mfg.shipment/1.0",
  "title": "mfg.shipment v1.0",
  "description": "Shipment status event (DISPATCHED then DELIVERED).",
  "x-business-key": "event_id",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shipment_id",
    "order_id",
    "warehouse_id",
    "sku",
    "quantity",
    "status"
  ],
  "properties": {
    "shipment_id": {
      "type": "string",
      "pattern": "^SHP-[0-9A-F]{12}$"
    },
    "order_id": {
      "type": "string",
      "pattern": "^ORD-[0-9A-F]{12}$"
    },
    "warehouse_id": {
      "type": "string",
      "pattern": "^WH-[A-Z]{3}-[0-9]{2}$"
    },
    "sku": {
      "type": "string",
      "pattern": "^[A-Z]{2,3}-[A-Z0-9]{2,8}$"
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "status": {
      "type": "string",
      "enum": [
        "DISPATCHED",
        "DELIVERED"
      ]
    }
  }
}
