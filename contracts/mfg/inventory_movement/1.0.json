{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "signalflow://contracts/mfg.inventory_movement/1.0",
  "title": "mfg.inventory_movement v1.0",
  "description": "Signed stock movement; source_ref names the authorizing business document.",
  "x-business-key": "movement_id",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "movement_id",
    "warehouse_id",
    "sku",
    "quantity_delta",
    "movement_type",
    "source_ref"
  ],
  "properties": {
    "movement_id": {
      "type": "string",
      "pattern": "^MOV-[0-9A-F]{12}$"
    },
    "warehouse_id": {
      "type": "string",
      "pattern": "^WH-[A-Z]{3}-[0-9]{2}$"
    },
    "sku": {
      "type": "string",
      "pattern": "^[A-Z]{2,3}-[A-Z0-9]{2,8}$"
    },
    "quantity_delta": {
      "type": "integer",
      "minimum": -100000,
      "maximum": 100000,
      "not": {
        "const": 0
      }
    },
    "movement_type": {
      "type": "string",
      "enum": [
        "OPENING_BALANCE",
        "PRODUCTION_RECEIPT",
        "SHIPMENT_OUT",
        "TRANSFER_OUT",
        "TRANSFER_IN",
        "RETURN_IN",
        "ADJUSTMENT"
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 40
    }
  }
}
