{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "signalflow://contracts/mfg.stock_count_approval/1.0",
  "title": "mfg.stock_count_approval v1.0",
  "description": "Approved cycle count that authorizes an inventory ADJUSTMENT.",
  "x-business-key": "approval_id",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_id",
    "warehouse_id",
    "sku",
    "counted_quantity",
    "system_quantity",
    "approved_by_role"
  ],
  "properties": {
    "approval_id": {
      "type": "string",
      "pattern": "^SCA-[0-9A-F]{12}$"
    },
    "warehouse_id": {
      "type": "string",
      "pattern": "^WH-[A-Z]{3}-[0-9]{2}$"
    },
    "sku": {
      "type": "string",
      "pattern": "^[A-Z]{2,3}-[A-Z0-9]{2,8}$"
    },
    "counted_quantity": {
      "type": "integer",
      "minimum": 0
    },
    "system_quantity": {
      "type": "integer"
    },
    "approved_by_role": {
      "type": "string",
      "enum": [
        "INVENTORY_CONTROLLER",
        "WAREHOUSE_MANAGER"
      ]
    }
  }
}
