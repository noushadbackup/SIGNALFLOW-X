  "editable": false,
  "description": "Every panel is a Prometheus query over the SignalFlow exporter, which reads Postgres at scrape time.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Exporter reading Postgres",
      "description": "1 = the last scrape read Postgres",
      "datasource": {
        "type": "prometheus",
        "uid": "signalflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "signalflow-prometheus"
          },
          "expr": "max(signalflow_up)",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP"
                },
                "0": {
                  "text": "DOWN"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
