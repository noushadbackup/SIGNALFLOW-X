# Copy to .env and choose your own password. .env is git-ignored.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=signalflow
PGPASSWORD=change-me-locally
PGDATABASE=signalflow
SIGNALFLOW_LOG_LEVEL=INFO

# --- stream profile (Phase 2) ---
# password of the replication role Debezium uses (the role is created by `signalflow stream init`)
SIGNALFLOW_CDC_PASSWORD=change-me-too
KAFKA_PORT=59092
CONNECT_PORT=58083
SIGNALFLOW_KAFKA_BOOTSTRAP=127.0.0.1:59092
SIGNALFLOW_CONNECT_URL=http://127.0.0.1:58083
SIGNALFLOW_STREAM_DB=signalflow_stream
SIGNALFLOW_ERP_DB=signalflow_erp
