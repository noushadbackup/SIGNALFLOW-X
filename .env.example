# Copy to .env and choose your own password. .env is git-ignored.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=signalflow
PGPASSWORD=change-me-locally
PGDATABASE=signalflow
SIGNALFLOW_LOG_LEVEL=INFO

# --- stream profile (Phase 2) ---
# password of the replication role Debezium uses (the role is created by `signalflow stream init`)
SIGNALFLOW_CDC_PASSWORD=change-me-too
KAFKA_PORT=59092
CONNECT_PORT=58083
SIGNALFLOW_KAFKA_BOOTSTRAP=127.0.0.1:59092
SIGNALFLOW_CONNECT_URL=http://127.0.0.1:58083
SIGNALFLOW_STREAM_DB=signalflow_stream
SIGNALFLOW_ERP_DB=signalflow_erp

# --- lake profile (Phase 3): SeaweedFS S3 gateway + Iceberg (JDBC catalog in Postgres) + Trino ---
SIGNALFLOW_S3_ACCESS_KEY=change-me-access-key
SIGNALFLOW_S3_SECRET_KEY=change-me-secret-key
SIGNALFLOW_S3_ENDPOINT=http://127.0.0.1:58333
SIGNALFLOW_LAKE_BUCKET=signalflow-lake
SIGNALFLOW_CATALOG_DB=signalflow_catalog
# the Postgres database the lake mirrors (Airflow DAG); one lake prefix mirrors exactly one database
SIGNALFLOW_LAKE_SOURCE_DB=signalflow_stream
S3_PORT=58333
TRINO_PORT=58080

# --- airflow profile (Phase 3) ---
# signing key shared by the Airflow API server, scheduler and DAG processor; generate one: openssl rand -hex 32
AIRFLOW_JWT_SECRET=change-me-to-a-random-hex-string
AIRFLOW_PORT=58081

# --- superset profile (Phase 3) ---
# generate: openssl rand -base64 42   /   choose an admin password (user "admin")
SUPERSET_SECRET_KEY=change-me-to-a-long-random-string
SUPERSET_ADMIN_PASSWORD=change-me
SUPERSET_PORT=58088

# --- Leak Hunter operators (Phase 4) ---
# Operators are created with `make operator OPERATOR=<name> ROLE=analyst`; the password is prompted and stored only as
# an scrypt hash. For scripted runs the CLI also reads SIGNALFLOW_NEW_OPERATOR_PASSWORD (when creating) and
# SIGNALFLOW_OPERATOR_PASSWORD (when acting on a case). Do not put either in this file.

# Observability (docker compose --profile observe up -d): Grafana admin password, ports bound to 127.0.0.1.
GRAFANA_ADMIN_PASSWORD=change-me
# SIGNALFLOW_METRICS_DB=signalflow   # database the exporter reads (default PGDATABASE)
